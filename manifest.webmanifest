{
  "id": "/ta-svg-viewer-261012/",
  "name": "TaViewsvg",
  "short_name": "TaViewsvg",
  "description": "A minimal, private SVG viewer made for touch.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f2f0",
  "theme_color": "#f2f2f0",
  "orientation": "any",
  "icons": [
    {
      "src": "./icons/icon-192-v5.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512-v5.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-192-v5.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-maskable-512-v5.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/svg+xml": [
          ".svg"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "svg",
          "accept": [
            "image/svg+xml",
            ".svg"
          ]
        }
      ]
    }
  }
}
